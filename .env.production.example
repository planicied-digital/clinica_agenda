# Copie para .env (mesma pasta do docker-compose.prod.yml) e preencha todos
# os valores antes de subir. Nada aqui tem default seguro — main.ts recusa
# subir em produção se JWT_SECRET, WHATSAPP_APP_SECRET, WHATSAPP_WEBHOOK_VERIFY_TOKEN,
# WHATSAPP_ACCESS_TOKEN ou WHATSAPP_PHONE_NUMBER_ID estiverem vazios/placeholder
# (ver src/config/assert-production-config.ts).

NODE_ENV=production
PORT=3000

# Credenciais do Postgres gerenciado pelo docker-compose.prod.yml (troque a
# senha; DATABASE_URL é montada automaticamente pelo compose a partir destas).
POSTGRES_USER=planicie
POSTGRES_PASSWORD=
POSTGRES_DB=planicie_digital
DATABASE_URL="postgresql://planicie:SUBSTITUA_PELA_MESMA_SENHA_ACIMA@postgres:5432/planicie_digital?schema=public"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token arbitrário que você escolhe e cadastra igual na Meta (handshake do webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard > Configurações > Básico ("App Secret") — não é o access token.
WHATSAPP_APP_SECRET=

# URL pública da API, embutida no build estático do front (web/Dockerfile) —
# trocar depois exige rebuildar a imagem do web, não só reiniciar o container.
VITE_API_URL=https://api.seu-dominio.com.br
